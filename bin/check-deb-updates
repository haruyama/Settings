#!/usr/bin/env bash
# Check whether the manually installed .deb packages (Slack, Dropbox,
# Docker Desktop, Docker CLI and plugins, GitHub CLI) are up to date with their upstream releases,
# and that packages from third-party apt repositories (Tailscale, Vivaldi, VSCodium,
# Chrome, Dropbox) still have an enabled repository after a release upgrade.
#
# Exit status: 0 = all up to date, 1 = updates available, 2 = check failed.

set -uo pipefail

outdated=0
failed=0

# Print the version only when the package is actually installed: dpkg keeps a
# Version for removed packages whose config files remain (status "rc"), too.
installed_version() {
	dpkg-query -W -f='${Status}\t${Version}\n' "$1" 2>/dev/null |
		awk -F'\t' '$1 ~ / installed$/ {print $2; exit}'
}

# label package latest_version download_url
compare() {
	local label="$1" pkg="$2" latest="$3" url="$4" current
	current="$(installed_version "$pkg")"
	if [ -z "$latest" ]; then
		printf '%-15s ? failed to fetch latest version\n' "$label"
		failed=1
	elif dpkg --compare-versions "$current" lt "$latest"; then
		printf '%-15s ! %s -> %s\n' "$label" "$current" "$latest"
		printf '%-15s   %s\n' "" "$url"
		outdated=1
	else
		printf '%-15s ✓ %s\n' "$label" "$current"
	fi
}

# label package: report and fail when the package is not installed here.
is_installed() {
	if [ -z "$(installed_version "$2")" ]; then
		printf '%-15s - not installed, skipped\n' "$1"
		return 1
	fi
}

fetch() { curl -fsSL --retry 2 --max-time 30 "$1"; }

# --- Slack: official API returns the latest .deb version as JSON ---
check_slack() {
	local json ver url
	json="$(fetch 'https://slack.com/api/desktop.latestRelease?arch=x64&variant=deb&redirect=false' || true)"
	ver="$(sed -n -E 's/.*"version":"([^"]+)".*/\1/p' <<<"$json")"
	url="$(sed -n -E 's/.*"download_url":"([^"]+)".*/\1/p' <<<"$json" | sed 's|\\/|/|g')"
	compare "Slack" slack-desktop "$ver" "$url"
}

# --- Dropbox: pick the newest dropbox_*.deb from the package index ---
check_dropbox() {
	local deb ver
	deb="$(fetch https://linux.dropbox.com/packages/ubuntu/ | grep -oE 'dropbox_[0-9.]+_amd64\.deb' | sort -uV | tail -n1 || true)"
	ver="$(sed -n -E 's/^dropbox_([0-9.]+)_amd64\.deb$/\1/p' <<<"$deb")"
	compare "Dropbox" dropbox "$ver" "https://linux.dropbox.com/packages/ubuntu/$deb"
}

# --- Docker Desktop: Sparkle appcast; the deb version is "<short>-<build>" ---
check_docker_desktop() {
	local item build short url
	item="$(fetch https://desktop.docker.com/linux/main/amd64/appcast.xml |
		sed -n -E 's/.*url="([^"]+)" sparkle:version="([0-9]+)" sparkle:shortVersionString="([^"]+)".*/\2 \3 \1/p' |
		sort -n | tail -n1 || true)"
	read -r build short url <<<"$item"
	compare "Docker Desktop" docker-desktop "${short:+$short-$build}" "${url:-}"
}

# --- GitHub CLI: latest release from the GitHub API (tag is "v<version>") ---
check_gh() {
	local json ver url
	json="$(fetch https://api.github.com/repos/cli/cli/releases/latest || true)"
	ver="$(sed -n -E 's/.*"tag_name": *"v([^"]+)".*/\1/p' <<<"$json" | head -n1)"
	url="$(grep -oE 'https://[^"]+_linux_amd64\.deb' <<<"$json" | head -n1 || true)"
	compare "GitHub CLI" gh "$ver" "$url"
}

# --- Docker CLI and its plugins: Docker Desktop depends on docker-ce-cli but does
# not ship it, and docker-buildx-plugin / docker-compose-plugin may be left over
# from Docker's apt repo. Read the apt Packages index for this release (Version
# carries the epoch); it is fetched once and shared by all packages. ---
docker_base=https://download.docker.com/linux/ubuntu
docker_packages=
# label package
check_docker_repo() {
	local label="$1" pkg="$2" codename item ver file
	if [ -z "$docker_packages" ]; then
		# shellcheck disable=SC1091
		codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
		docker_packages="$(fetch "$docker_base/dists/$codename/stable/binary-amd64/Packages" || true)"
	fi
	item="$(awk -v pkg="$pkg" '/^Package:/{p=$2} /^Version:/{v=$2} /^Filename:/{f=$2}
			/^$/{if (p == pkg) print v, f; p = ""}
			END{if (p == pkg) print v, f}' <<<"$docker_packages" |
		sort -V | tail -n1 || true)"
	read -r ver file <<<"$item"
	compare "$label" "$pkg" "${ver:-}" "${file:+$docker_base/$file}"
}

# --- Packages that come from third-party apt repositories. A release upgrade
# disables those sources, after which apt silently stops updating them; report
# when no repository offers the package any more, when apt has a newer one, or
# when a source still names an older Ubuntu release (e.g. re-enabled by hand
# without updating the suite). ---
# shellcheck disable=SC1091
os_codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
ubuntu_codenames="$(cut -d, -f3 /usr/share/distro-info/ubuntu.csv 2>/dev/null | tail -n +2)"
# label package
check_apt_repo() {
	local label="$1" pkg="$2" policy current candidate suite
	policy="$(LC_ALL=C apt-cache policy "$pkg" 2>/dev/null)"
	current="$(installed_version "$pkg")"
	candidate="$(sed -n -E 's/^ +Candidate: +//p' <<<"$policy")"
	if ! grep -qE '^ +-?[0-9]+ +(https?|file|cdrom):' <<<"$policy"; then
		printf '%-15s ! %s: no apt repository provides it (source disabled?)\n' "$label" "$current"
		outdated=1
	elif dpkg --compare-versions "$current" lt "$candidate"; then
		printf '%-15s ! %s -> %s (apt upgrade)\n' "$label" "$current" "$candidate"
		outdated=1
	else
		printf '%-15s ✓ %s (apt)\n' "$label" "$current"
	fi
	for suite in $(sed -n -E 's|^ +-?[0-9]+ +https?://[^ ]+ +([^/ ]+)/.*|\1|p' <<<"$policy" | sort -u); do
		suite="${suite%%-*}"
		if [ "$suite" != "$os_codename" ] && grep -qxF "$suite" <<<"$ubuntu_codenames"; then
			printf '%-15s   source still points to %s (this release is %s)\n' "" "$suite" "$os_codename"
			outdated=1
		fi
	done
}

is_installed "Slack" slack-desktop && check_slack
is_installed "Dropbox" dropbox && check_dropbox
is_installed "Docker Desktop" docker-desktop && check_docker_desktop
is_installed "Docker CLI" docker-ce-cli && check_docker_repo "Docker CLI" docker-ce-cli
is_installed "Docker Buildx" docker-buildx-plugin && check_docker_repo "Docker Buildx" docker-buildx-plugin
is_installed "Docker Compose" docker-compose-plugin && check_docker_repo "Docker Compose" docker-compose-plugin
is_installed "GitHub CLI" gh && check_gh

while read -r label pkg; do
	is_installed "$label" "$pkg" && check_apt_repo "$label" "$pkg"
done <<'EOF'
Tailscale tailscale
Vivaldi vivaldi-stable
VSCodium codium
Chrome google-chrome-stable
Dropbox(apt) dropbox
EOF

if [ "$failed" -ne 0 ]; then
	exit 2
fi
exit "$outdated"
